# =============================================
# tracen: Development environment variables
# - [config] は設定パラメータ、[secret] は機密情報です
# =============================================

# --- Node/Runtime ------------------------------------------
# [config] production / development など
NODE_ENV=development

# --- Database (PostgreSQL) ---------------------------------
# [config] Dev PostgreSQL database name
POSTGRES_DB=tracen

# [config] Dev PostgreSQL user
POSTGRES_USER=tracen

# [secret] Dev PostgreSQL password (ローカル開発用)
POSTGRES_PASSWORD=tracen

# --- Redis -------------------------------------------------
# [secret] Dev Redis password (ローカル開発用)
REDIS_PASSWORD=tracen_secret

# --- Backend (Hono) ----------------------------------------
# [config] Backend database connection URL (used by Drizzle/postgres.js)
DATABASE_URL=postgresql://tracen:tracen@db:5432/tracen

# [config] Run DB migrations automatically on backend startup
RUN_MIGRATIONS=true

# [config] File storage base directory
FILE_STORAGE_BASE_DIR=/app/uploads

# [config] JWT issuer (used for validating JWTs)
JWT_ISSUER=https://ft_transcendence.42.fr/

# [secret] Pepper user password (used for hashing user passwords)
PEPPER=some_random_pepper_value

# [secret] Access token expiration time by seconds (e.g., 900 for 15 minutes)
ACCESS_TOKEN_EXPIRES_IN=900

# [secret] Refresh token expiration time (e.g., 7d for 7 days)
REFRESH_TOKEN_EXPIRES_IN=7d

# --- BFF(server) -> Backend API ----------------------------
# [config] BFF(Next server) から backend(Hono) を呼ぶためのベースURL
# - dev は Docker ネットワーク内で backend サービスへ到達します
APP_API_BASE_URL=http://backend:8000

# --- Frontend(browser) -> BFF API --------------------------
# [config/public] ブラウザから BFF API を呼ぶためのベースURL
# - NEXT_PUBLIC_ はクライアントバンドルに公開されます
# - dev は nginx 経由の入口(http://localhost:8080)を想定
NEXT_PUBLIC_BFF_API_BASE_URL=http://localhost:8080/api


# --- analytics / monitoring --------------------------------
# --- elasticsearch -----------------------------------------
# [config]
discovery.type=single-node
xpack.security.enabled=false
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- kibana ------------------------------------------------
# [config] Kibana URL (used for accessing Kibana dashboard)
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# [config] Kibana base path (used for accessing Kibana dashboard)
SERVER_BASEPATH=/kibana
SERVER_REWRITEBASEPATH=true

# [config/public] Kibana public base URL (used for accessing Kibana dashboard from browser)
SERVER_PUBLICBASEURL=http://localhost:8080/kibana


# --- logstash ------------------------------------------------
# [config] Logstash Java options (used for configuring Logstash JVM)
LS_JAVA_OPTS=-Xms256m -Xmx256m

# --- grafana ------------------------------------------------
# [secret] Grafana admin password (used for Grafana login)
GF_SECURITY_ADMIN_PASSWORD=tracen
