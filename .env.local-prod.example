# =============================================
# tracen: Local production-like environment variables
# - [config] は設定パラメータ、[secret] は機密情報です
# - 値はローカル実行向けの安全なデフォルトです
# =============================================

# --- Node/Runtime ------------------------------------------
# [config] production / development など
NODE_ENV=production

# --- Local registry (https://registry.tracen.local:5000) ----
# [config] registry listen address
REGISTRY_HTTP_ADDR=0.0.0.0:5000

# [config] registry TLS certificate path (in container)
REGISTRY_HTTP_TLS_CERTIFICATE=/etc/registry/tls/tls.crt

# [secret] registry TLS private key path (in container)
REGISTRY_HTTP_TLS_KEY=/etc/registry/tls/tls.key

# --- Database (PostgreSQL) ---------------------------------
# [config] PostgreSQL database name
POSTGRES_DB=tracen

# [config] PostgreSQL user
POSTGRES_USER=tracen

# [secret] PostgreSQL password
POSTGRES_PASSWORD=tracen

# [config] Backend database connection URL (used by Drizzle/postgres.js)
DATABASE_URL=postgresql://tracen:tracen@db:5432/tracen

# [config] Run DB migrations automatically on backend startup
RUN_MIGRATIONS=true

# --- Redis -------------------------------------------------
# [secret] Dev Redis password
REDIS_PASSWORD=tracen_secret

# --- Backend (Hono) ----------------------------------------
# [config] backend listen port (nginx upstream)
BACKEND_PORT=8443

# [config] backend TLS certificate path (in container)
BACKEND_TLS_CERT_PATH=/etc/tracen/certs/tls.crt

# [config] File storage base directory
FILE_STORAGE_BASE_DIR=/app/uploads

# [config] JWT issuer (used for validating JWTs)
JWT_ISSUER=https://ft_transcendence.42.fr/

# [secret] backend TLS private key path (in container)
BACKEND_TLS_KEY_PATH=/etc/tracen/certs/tls.key

# [secret] Pepper user password (used for hashing user passwords)
PEPPER=some_random_pepper_value

# [secret] Access token expiration time by seconds (e.g., 900 for 15 minutes)
ACCESS_TOKEN_EXPIRES_IN=900

# [secret] Refresh token expiration time (e.g., 7d for 7 days)
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Frontend-BFF (Next.js custom HTTPS server) ------------
# [config] frontend-bff listen port (nginx upstream)
FRONTEND_PORT=3443

# [config] frontend-bff TLS certificate path (in container)
FRONTEND_TLS_CERT_PATH=/etc/tracen/certs/tls.crt

# [secret] frontend-bff TLS private key path (in container)
FRONTEND_TLS_KEY_PATH=/etc/tracen/certs/tls.key

# [config] mkcert CA certificate path (in container)
# - BFF(server) が backend を HTTPS で呼ぶための信頼ストアとして使用
NODE_EXTRA_CA_CERTS=/etc/tracen/certs/ca.crt

# --- BFF(server) -> Backend API ----------------------------
# [config] BFF(Next server) から backend(Hono) を呼ぶためのベースURL
APP_API_BASE_URL=https://backend.tracen.local:8443

# --- Frontend(browser) -> BFF API --------------------------
# [config/public] ブラウザから BFF API を呼ぶためのベースURL
# - NEXT_PUBLIC_ はクライアントバンドルに公開されます
# - これは build 時に注入される必要があります（NEXT_PUBLIC_*）
NEXT_PUBLIC_BFF_API_BASE_URL=https://tracen.local/api

# --- analytics (ELK) ---------------------------------------
# dev と異なり security + TLS を有効化し、入口〜コンテナ間まで全区間 HTTPS にする。
# ES/Logstash は外部公開せず、Kibana のみ Nginx 経由(https://kibana.tracen.local、要ログイン)で公開する。
# 各サービスは *.tracen.local のワイルドカード証明書(tls.crt/key, ca.crt)を /certs にマウントして使う。
# --- elasticsearch (TLS 有効, https:9200) ------------------
# [config]
discovery.type=single-node
xpack.security.enabled=true
xpack.security.http.ssl.enabled=true
xpack.security.http.ssl.certificate=/certs/tls.crt
xpack.security.http.ssl.key=/certs/tls.key
ES_JAVA_OPTS=-Xms512m -Xmx512m
# [secret] elastic スーパーユーザーのパスワード(本番前に必ず変更する)
ELASTIC_PASSWORD=change_me_elastic_pw

# --- kibana (TLS 待ち受け, ES へ https) --------------------
# [config] Kibana は kibana_system ユーザーで ES に接続する(elastic は superuser のため Kibana から使用不可)
# ES 接続はサブドメイン(証明書 SAN *.tracen.local に一致)で行う
ELASTICSEARCH_HOSTS=https://elasticsearch.tracen.local:9200
ELASTICSEARCH_USERNAME=kibana_system
ELASTICSEARCH_PASSWORD=change_me_kibana_pw
ELASTICSEARCH_SSL_CERTIFICATEAUTHORITIES=/certs/ca.crt
# [secret] kibana_system のパスワード(es-setup が ES 起動後に設定する。ELASTICSEARCH_PASSWORD と同値にする)
KIBANA_SYSTEM_PASSWORD=change_me_kibana_pw
# Kibana 自身も TLS で待ち受ける
SERVER_SSL_ENABLED=true
SERVER_SSL_CERTIFICATE=/certs/tls.crt
SERVER_SSL_KEY=/certs/tls.key
# [config/public] ブラウザからの Kibana アクセスURL(サブドメイン)
SERVER_PUBLICBASEURL=https://kibana.tracen.local

# --- logstash (ES へ https, beats TLS) ---------------------
# 接続先(https)・証明書パスは pipeline-local-prod/events.conf に直書き。
# ここでは ES への認証情報のみ注入する(events.conf が ${LOGSTASH_ES_*} で参照)。
LS_JAVA_OPTS=-Xms256m -Xmx256m
LOGSTASH_ES_USER=elastic
LOGSTASH_ES_PASSWORD=change_me_elastic_pw

# --- filebeat (Logstash へ TLS 送信) -----------------------
LOGSTASH_HOSTS=logstash.tracen.local:5044
LOGSTASH_SSL_ENABLED=true
LOGSTASH_SSL_CA=/certs/ca.crt

# --- grafana ------------------------------------------------
# [secret] Grafana admin password (used for Grafana login)
GF_SECURITY_ADMIN_PASSWORD=tracen
