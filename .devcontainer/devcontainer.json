{
  "name": "tracen Workspace",
  "dockerComposeFile": ["../docker-compose.dev.yml"],
  "service": "dev-container",
  "workspaceFolder": "/workspace",
  "runServices": ["dev-container", "backend", "frontend", "nginx", "db", "redis"],
  "forwardPorts": [3000, 8000, 8080, 5432, 4983, 6379, 9200, 5601, 9090, 3001, 9093],
  "mounts": [
    // ワークスペース本体のバインドマウント
    "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
    // ルートおよびサブパッケージごとの node_modules ボリューム分離設定
    "source=tracen-root-node-modules,target=/workspace/node_modules,type=volume",
    "source=tracen-contracts-node-modules,target=/workspace/containers/apps/contracts/node_modules,type=volume",
    "source=tracen-backend-node-modules,target=/workspace/containers/apps/backend/node_modules,type=volume",
    "source=tracen-frontend-bff-node-modules,target=/workspace/containers/apps/frontend-bff/node_modules,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/scripts/postCreateCommand.sh",
  "postStartCommand": "echo 'Container started successfully'",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteEnv": {
    "TRACEN_LOCAL_CI_HOST_WORKSPACE": "${localWorkspaceFolder}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // 基本・品質管理
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "editorconfig.editorconfig",
        "usernamehw.errorlens",
        "github.copilot-chat",
        "anthropic.claude-code",

        // Next.js / React / Tailwind
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",
        "formulahendry.auto-rename-tag",

        // Hono / Backend 開発
        "humao.rest-client",
        "wallabyjs.console-ninja",

        // DB
        "ms-ossdata.vscode-pgsql",
        "davidsekar.redis-xplorer",

        // Git / チーム開発
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "ms-vsliveshare.vsliveshare"
      ]
    }
  },
  "remoteUser": "node"
}
