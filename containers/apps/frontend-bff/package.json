{
  "name": "@tracen/frontend-bff",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:start": "docker compose -f ../../../docker-compose.dev.yml -p ft_transcendence start frontend",
    "dev:restart": "rm -fr .next && docker compose -f ../../../docker-compose.dev.yml -p ft_transcendence restart frontend",
    "dev:stop": "docker compose -f ../../../docker-compose.dev.yml -p ft_transcendence stop frontend",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tracen/backend": "workspace:*",
    "@tracen/contracts": "workspace:*",
    "clsx": "^2.1.1",
    "hono": "^4.12.14",
    "lucide-react": "^1.7.0",
    "next": "^16.2.3",
    "next-intl": "^4.9.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.0.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "8.0.10"
  }
}
