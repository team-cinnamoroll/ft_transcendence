{
  "name": "@tracen/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock:add-seed": "cd test/mocking && tsx seed-mock-data.ts"
  },
  "dependencies": {
    "@hono-rate-limiter/redis": "^0.1.4",
    "@hono/node-server": "^2.0.11",
    "@hono/zod-validator": "^0.7.6",
    "@tracen/contracts": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.11.1",
    "mime": "^4.1.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hono/vite-dev-server": "^0.25.3",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
